# AWS / Floci
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1

# S3
S3_BUCKET=clickstream-bucket
RAW_S3_KEY=raw/all_events.ndjson
MODEL_S3_KEY=models/modelo_propension.pkl

# DynamoDB
DYNAMODB_TABLE=clickstream-sessions

# Lambda
LAMBDA_FUNCTION_NAME=clickstream-ingestion
LAMBDA_HANDLER=lambda_function.lambda_handler
LAMBDA_RUNTIME=python3.11
LAMBDA_TIMEOUT=30
LAMBDA_MEMORY=512

# ECS
ECS_CLUSTER_NAME=clickstream-cluster
ECS_TASK_FAMILY=clickstream-inference
ECS_CONTAINER_NAME=inference
ECS_IMAGE=clickstream-inference:latest
ECS_CPU=512
ECS_MEMORY=1024
ECS_CONTAINER_PORT=8080
ECS_SERVICE_NAME=clickstream-inference-service
ECS_DESIRED_COUNT=1

# API Gateway
API_GATEWAY_NAME=clickstream-api

# ALB
ALB_NAME=clickstream-alb
TARGET_GROUP_NAME=clickstream-tg

# Frontend (generado por Terraform)
# CLIENTSTREAM_CONFIG_API_URL=https://xxx.execute-api.us-east-1.amazonaws.com/prod/events